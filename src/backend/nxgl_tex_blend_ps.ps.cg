struct vOut {
    float4 color : COLOR;
    float2 tex0  : TEXCOORD0;
};

float4 main(
    vOut I,
    uniform sampler2D colorMap,
    uniform float4 envColor
    ) : COLOR
{
    float4 texel = tex2D(colorMap, I.tex0.xy);
    return float4(I.color.rgb * (1.0f - texel.rgb) + envColor.rgb * texel.rgb, texel.a * I.color.a);
}
